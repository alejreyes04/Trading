{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/session-start.sh",
            "timeout": 300,
            "statusMessage": "Instalando dependencias del proyecto"
          }
        ]
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python -m trading *)",
      "Bash(python3 -m trading *)",
      "Bash(python -m pytest *)",
      "Bash(python3 -m pytest *)",
      "Bash(pip install -e *)",
      "Bash(python3 -m pip install -e *)",
      "Bash(git status *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git checkout *)",
      "Bash(git merge *)",
      "Bash(git pull *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git branch *)",
      "Bash(git rev-parse *)",
      "WebSearch",
      "WebFetch"
    ]
  }
}
